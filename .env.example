# StudyAI uses local Ollama for every AI feature. Cloud provider settings are not used.
# Local Ollama needs no API key. Install Ollama, then run:
# ollama pull qwen2.5:3b
STUDYAI_PROVIDER=ollama
# Required when deploying: generate with
# python3 -c "import secrets; print(secrets.token_hex(32))"
# SESSION_SECRET=generate-a-long-random-secret
# Optional: enable only when serving the site over HTTPS.
# COOKIE_SECURE=1
# Set to production to prevent Flask debug mode from being enabled.
# STUDYAI_ENV=production

# Optional: defaults to qwen2.5:3b
# OLLAMA_MODEL=qwen2.5:3b
# Optional vision model for solving uploaded question images; install with `ollama pull llava:7b`
# OLLAMA_VISION_MODEL=llava:7b
# Ollama Cloud uses https://ollama.com/v1 and requires an API key.
# Keep the key server-side; never expose it in browser code or source control.
# OLLAMA_API_KEY=your_ollama_api_key_here
# Optional: use a different Ollama address
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# To use GLM-5-Turbo through AI/ML API:
# STUDYAI_PROVIDER=aimlapi
# AIMLAPI_API_KEY=your_aimlapi_key_here
# Optional: defaults to z-ai/glm-5-turbo (supports text and images)
# AIMLAPI_MODEL=z-ai/glm-5-turbo
# AIMLAPI_VISION_MODEL=z-ai/glm-5-turbo
# Optional: custom AI/ML API OpenAI-compatible endpoint
# AIMLAPI_BASE_URL=https://api.aimlapi.com/v1

# To use Google Gemini:
# STUDYAI_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# Optional: defaults to gemini-3.8-flash (supports text and images)
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_VISION_MODEL=gemini-3.8-flash
# Optional: custom Gemini OpenAI-compatible API endpoint
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# To use Groq instead, choose groq and provide a key:
# STUDYAI_PROVIDER=groq
# GROQ_API_KEY=your_groq_api_key_here
# Optional: defaults to llama-3.3-70b-versatile when using Groq
# GROQ_MODEL=llama-3.3-70b-versatile
# Optional vision-capable model for uploaded question images
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Or use OpenAI:
# STUDYAI_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# Optional: defaults to gpt-4o-mini when using OpenAI
# OPENAI_MODEL=gpt-4o-mini
# Optional vision-capable model for uploaded question images
# OPENAI_VISION_MODEL=gpt-4o-mini
# Optional: custom API endpoints for cloud providers
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_BASE_URL=https://api.openai.com/v1
